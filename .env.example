# Supabase transaction-pooler URL used by the running API (port 6543).
# Keep credentials backend-only and append pgbouncer=true&connection_limit=1.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Supabase session-pooler (or IPv6 direct) URL used only by Prisma migrations (port 5432).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Optional disposable PostgreSQL database used only by the API test suite.
TEST_DATABASE_URL=""
TEST_DIRECT_URL=""
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Optional dedicated encryption secret for employer candidate evidence and notes.
# If empty, SESSION_SECRET is used. Keep stable; changing it requires data re-encryption.
SCREENING_ENCRYPTION_KEY=""
PORT=4000
WEB_ORIGIN="http://localhost:5173"
NODE_ENV="development"
JOOBLE_API_KEY=""
JOOBLE_API_ENABLED="false"
JOOBLE_REQUEST_BUDGET="450"
JOB_CACHE_TTL_MINUTES="60"
